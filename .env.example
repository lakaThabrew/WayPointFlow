# ── WaypointFlow web — environment template ───────────────────────────────
# Copy to .env and adjust. NEVER commit real environment files.

# Base URL of the WaypointFlow API (no trailing slash).
# Local dev default — the api service runs on :4000:
VITE_API_URL=http://localhost:4000

# Production example — the deployed API origin:
# VITE_API_URL=https://<your-api-host>
