# ── WaypointFlow API — environment template ───────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env / .env.production.

# PostgreSQL connection string (local dev — the docker-compose `db` service).
# NOTE: this machine publishes the container on host port 55432 because the
# host's own PostgreSQL 18 already occupies 5432/5433. On a clean machine you
# can use 5432 (keep docker-compose.yml's port mapping consistent).
DATABASE_URL="postgresql://waypoint:waypoint@localhost:55432/waypointflow?schema=public"

# Production (Supabase) — use the DIRECT connection string (port 5432),
# NOT the transaction pooler (port 6543 breaks Prisma migrations):
# DATABASE_URL="postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres"

# Port the API listens on
PORT=4000

# Secret used to sign JWTs — use a strong random string in production
JWT_SECRET=local-dev-secret-change-in-production

# Hour of day (0–23, local server time) after which next-day ordering closes.
# The approved design shows 4:00 PM.
ORDER_CUTOFF_HOUR=16
